    "pretty-quick": "^3.3.1",
    "rimraf": "^3.0.2",
    "tailwindcss": "^2.2.19",
    "typescript": "^5.3.0",
    "unplugin-vue-components": "^0.22.12",
    "vite": "^5.4.21",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-html": "^2.1.2",
